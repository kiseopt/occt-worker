+IFSelect_ReturnStatus IGESControl_Reader::ReadStream(const char* const theName,
+                                                     std::istream&     theIStream)
+{
+  const std::string aData((std::istreambuf_iterator<char>(theIStream)),
+                          std::istreambuf_iterator<char>());
+  const occ::handle<XSControl_WorkSession> aSession = WS();
+  if (aSession.IsNull() || aSession->Protocol().IsNull())
+  {
+    return IFSelect_RetVoid;
+  }
+  const occ::handle<IGESData_Protocol> aProtocol =
+    occ::down_cast<IGESData_Protocol>(aSession->Protocol());
+  occ::handle<IGESData_IGESModel> aModel = new IGESData_IGESModel;
+  const int aStatus = IGESFile_ReadStream(aData.data(), aData.size(), aModel, aProtocol);
+  if (aStatus != 0)
+  {
+    return aStatus < 0 ? IFSelect_RetError : IFSelect_RetFail;
+  }
+  aSession->SetModel(aModel);
+  aSession->SetLoadedFile(theName == nullptr ? "" : theName);
+  aSession->InitTransferReader(4);
+  return IFSelect_RetDone;
+}
+
