+int igesread (char* nomfic, int lesect[6], int modefnes)
+{
+  FILE* lefic = stdin;
+  if (nomfic[0] != '\0')
+  {
+    lefic = OSD_OpenFile(nomfic, "r");
+  }
+  if (lefic == NULL) return -1;
+  int result = igesread_file(lefic, lesect, modefnes);
+  fclose(lefic);
+  return result;
+}
+
+int igesread_stream(const char* data, size_t length, int lesect[6], int modefnes)
+{
+  if (data == NULL && length != 0) return -1;
+  FILE* lefic = fmemopen((void*)data, length, "rb");
+  if (lefic == NULL) return -1;
+  int result = igesread_file(lefic, lesect, modefnes);
+  fclose(lefic);
+  return result;
+}
